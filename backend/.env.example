# Environment mode: development/production
DJANGO_ENV=development

# Секретный ключ Django (обязательно замените)
DJANGO_SECRET_KEY=change-me

# Режим отладки
DJANGO_DEBUG=true

# Разрешённые хосты
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# CORS
DJANGO_CORS_ALLOW_ALL_ORIGINS=true
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# База данных (DB_PASSWORD обязателен — приложение не запустится без него)
DB_NAME=kpi_db
DB_USER=postgres
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5432

# Расчёт премий
# KPI_BASE_SALARY=50000

# Crossref API (для интеграции с научными публикациями)
# CROSSREF_MAILTO=your-email@example.com
# CROSSREF_USER_AGENT=KPI-Management-System/1.0 (mailto:your-email@example.com)
