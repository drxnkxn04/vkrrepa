# frontend/.env.production
# Конфигурация для production

# URL Backend API (измените на ваш production URL)
VUE_APP_API_URL=https://your-domain.com

# Название приложения
VUE_APP_TITLE=KPI Management System

# Режим отладки (отключен в production)
VUE_APP_DEBUG=false

# Таймаут запросов (в миллисекундах)
VUE_APP_REQUEST_TIMEOUT=15000